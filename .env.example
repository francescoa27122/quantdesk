# QuantDesk environment. Copy to `.env` and fill in.
#
# SECRETS DO NOT LIVE HERE. Exchange keys, the Telegram token and the session
# secret are Docker *secrets*, read from files under ./secrets/ (see
# docker-compose.yml). This file holds only non-sensitive configuration plus
# the Postgres password, which never leaves the internal Docker network.
#
# Everything under ./secrets/ must be chmod 600 and is in .gitignore.

# ── core ─────────────────────────────────────────────────────────────────
QD_ENV=prod
TZ=America/Chicago

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME

# paper | live
#
# Setting this to `live` is NOT sufficient to trade with real money. Live
# orders additionally require a valid, unexpired row in the `live_arming`
# table, written only by `qd arm-live` after you type a confirmation phrase.
# Two independent switches, deliberately.
QD_MODE=paper

# ── exchange ─────────────────────────────────────────────────────────────
QD_EXCHANGE=kraken
QD_QUOTE_CCY=USD
QD_SYMBOLS=BTC/USD,ETH/USD,SOL/USD
QD_TIMEFRAMES=1h,4h,1d

# Read at boot from the exchange and cached; these are only the fallback used
# before the first successful fetch. Kraken $0-tier as of writing — VERIFY,
# because every fee gate and every backtest is calibrated off these numbers.
QD_MAKER_FEE_BPS=25
QD_TAKER_FEE_BPS=40

# ── notifications ────────────────────────────────────────────────────────
# The bot TOKEN is a Docker secret. Only the chat id lives here.
QD_TELEGRAM_CHAT_ID=
QD_DISCORD_WEBHOOK_URL=
QD_SMTP_HOST=
QD_SMTP_PORT=587
QD_SMTP_USER=
QD_NOTIFY_EMAIL_TO=

# Quiet hours for NON-critical notifications only. Risk-critical alerts
# (drawdown halts, reconciliation mismatch, exchange down) always go loud.
QD_QUIET_HOURS=22:00-07:00

# ── web ──────────────────────────────────────────────────────────────────
# Generate with: qd hash-password — and paste the `QD_ADMIN_PASSWORD_HASH=`
# line it prints, not the bare hash. Every `$` must be doubled: compose
# interpolates `$` in this file and quoting does not stop it, so a raw argon2
# hash arrives at the container as `=19=65536,t=3,p=4` and every login fails.
QD_ADMIN_PASSWORD_HASH=
QD_SESSION_TTL_HOURS=12
QD_REQUIRE_TOTP=false

# ── risk defaults ────────────────────────────────────────────────────────
# These seed `risk_config`; after first boot the DB row is authoritative and
# is edited from the dashboard (with a diff + confirm) or `qd set-risk`.
QD_RISK_PER_TRADE=0.005
QD_MAX_DAILY_DRAWDOWN=0.03
QD_MAX_WEEKLY_DRAWDOWN=0.07
QD_MAX_TOTAL_DRAWDOWN=0.20
QD_MAX_GROSS_EXPOSURE=0.60
QD_MAX_OPEN_POSITIONS=5
QD_MIN_EDGE_BPS=60

# ── live-trading arming defaults (used by `qd arm-live`) ─────────────────
QD_ARM_DEFAULT_HOURS=168          # 7 days, then it auto-disarms
QD_ARM_MAX_NOTIONAL_USD=250
QD_ARM_MAX_DAILY_NOTIONAL_USD=1000

# ── paths ────────────────────────────────────────────────────────────────
QD_KILL_SWITCH_FILE=/app/state/KILL
QD_HOST_HEALTH_FILE=/hosthealth/metrics.json
